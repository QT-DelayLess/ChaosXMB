<Window x:Class="ChaosXMB.Views.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChaosXMB • Oyun Ekle / Düzenle" Width="1050" Height="800" MinWidth="850" MinHeight="660"
        Background="#0B1422" Foreground="White" WindowStartupLocation="CenterOwner">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="OYUN KÜTÜPHANESİ" Foreground="#74D4FF" FontSize="13" FontWeight="Bold"/>
            <TextBlock Text="Oyun ekle veya düzenle" FontSize="30" FontWeight="Light" Margin="0,5,0,4"/>
            <TextBlock Text="EXE seç, internetten eşleşme bul, bilgileri doğrula ve kaydet." Foreground="#9FB4C7" FontSize="14"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="ÇALIŞTIRILACAK DOSYA" Foreground="#93C4D8" Margin="0,0,0,6"/>
                    <DockPanel LastChildFill="True" Margin="0,0,0,14">
                        <Button Content="Gözat" Click="BrowseExecutable_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                        <TextBox x:Name="ExePathBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="OYUN ADI" Foreground="#93C4D8" Margin="0,0,0,6"/>
                    <TextBox x:Name="TitleBox" Margin="0,0,0,14"/>
                    <TextBlock Text="İNTERNETTE ARA (STEAM)" Foreground="#93C4D8" Margin="0,0,0,6"/>
                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                        <Button Content="Ara" Click="Search_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                        <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="MatchesList" Height="128" SelectionChanged="MatchesList_SelectionChanged"
                             Background="#231F3A50" Foreground="White" BorderBrush="#3C6A88" Margin="0,0,0,12"/>
                    <TextBlock x:Name="StatusLabel" Text="Steam eşleşmesi bulunamazsa bilgileri kendin doldurabilirsin."
                               TextWrapping="Wrap" Foreground="#A1BDCF" FontSize="12" Margin="0,0,0,14"/>
                    <TextBlock Text="KATEGORİ" Foreground="#93C4D8" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CategoryChoice" SelectedIndex="0" Margin="0,0,0,14">
                        <ComboBoxItem Content="Games"/><ComboBoxItem Content="Apps"/>
                    </ComboBox>
                    <TextBlock Text="BAŞLATMA ARGÜMANLARI (İSTEĞE BAĞLI)" Foreground="#93C4D8" Margin="0,0,0,6"/>
                    <TextBox x:Name="ArgumentsBox" Margin="0,0,0,14"/>
                    <TextBlock Text="GELİŞTİRİCİ" Foreground="#93C4D8" Margin="0,0,0,6"/>
                    <TextBox x:Name="DeveloperBox" Margin="0,0,0,14"/>
                    <TextBlock Text="TÜR" Foreground="#93C4D8" Margin="0,0,0,6"/>
                    <TextBox x:Name="GenreBox" Margin="0,0,0,14"/>
                    <TextBlock Text="ÇIKIŞ TARİHİ" Foreground="#93C4D8" Margin="0,0,0,6"/>
                    <TextBox x:Name="ReleaseBox" Margin="0,0,0,14"/>
                    <TextBlock Text="AÇIKLAMA" Foreground="#93C4D8" Margin="0,0,0,6"/>
                    <TextBox x:Name="DescriptionBox" TextWrapping="Wrap" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="#1B344A" CornerRadius="10" Height="240" Margin="0,0,0,10">
                        <Image x:Name="CoverPreview" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="KAPAK (URL VEYA YEREL DOSYA)" Foreground="#93C4D8" Margin="0,0,0,6"/>
                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                        <Button Content="Dosya" Click="BrowseCover_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                        <TextBox x:Name="CoverBox" LostFocus="ImageText_LostFocus"/>
                    </DockPanel>
                    <TextBlock Text="ARKA PLAN (URL VEYA YEREL DOSYA)" Foreground="#93C4D8" Margin="0,0,0,6"/>
                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                        <Button Content="Dosya" Click="BrowseHero_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                        <TextBox x:Name="HeroBox" LostFocus="ImageText_LostFocus"/>
                    </DockPanel>
                    <Border Background="#122839" CornerRadius="9" Height="160">
                        <Image x:Name="HeroPreview" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="Kapak veya hero bulunamazsa uygulama sembol ve renk gradyanı kullanır." Foreground="#829FB6" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,18,0,0">
            <Button DockPanel.Dock="Right" Content="KAYDET" Width="140" Background="#365C8EB6" Margin="10,0,0,0" Click="Save_Click"/>
            <Button DockPanel.Dock="Right" Content="Vazgeç" Width="110" Click="Cancel_Click"/>
        </DockPanel>
    </Grid>
</Window>
