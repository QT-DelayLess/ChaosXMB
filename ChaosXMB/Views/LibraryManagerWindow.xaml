<Window x:Class="ChaosXMB.Views.LibraryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ChaosXMB • Library Manager"
        Width="810" Height="570" WindowStartupLocation="CenterOwner" Background="#0D192A" Foreground="White">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="KÜTÜPHANE YÖNETİMİ" FontSize="26" FontWeight="Light" Margin="0,0,0,20"/>
        <ListBox Grid.Row="1" x:Name="GamesList" Background="#12263A" Foreground="White" BorderBrush="#4D7B9C" FontSize="15">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="10,7"><TextBlock Text="{Binding Title}" FontSize="18" Foreground="White"/>
                        <TextBlock Text="{Binding ExecutablePath}" FontSize="12" Foreground="#A7BCCB" TextTrimming="CharacterEllipsis"/></StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,19,0,0">
            <Button Content="+ OYUN EKLE" Margin="0,0,9,0" Click="Add_Click"/>
            <Button Content="DÜZENLE" Margin="0,0,9,0" Click="Edit_Click"/>
            <Button Content="SİL" Margin="0,0,9,0" Click="Remove_Click"/>
            <Button Content="KAPAT" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
