<Window x:Class="ChaosXMB.Views.StoreScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChaosXMB · Oyunları Tara" Width="920" Height="680" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#091827" Foreground="#ECF6FC"
        FontFamily="Segoe UI" ShowInTaskbar="False" Loaded="Window_Loaded">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="OYUNLARI TARA" Foreground="#9DE3FF" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="Steam · Epic Games · GOG" FontSize="28" FontWeight="Light" Margin="0,8,0,6"/>
                <TextBlock Text="Yüklü oyunları bilgisayarındaki mağaza kayıtlarından bulur. Hiçbir oyun otomatik eklenmez."
                           Foreground="#9DB6CA" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="RescanButton" Grid.Column="1" Content="↻  YENİDEN TARA" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Rescan_Click" Margin="12,0,0,0"/>
        </Grid>
        <TextBlock Grid.Row="1" x:Name="StatusText" Foreground="#91D8F9" Margin="0,22,0,12" Text="Hazırlanıyor..." TextWrapping="Wrap"/>
        <Border Grid.Row="2" BorderBrush="#34546C" BorderThickness="1" CornerRadius="9" Background="#45102032">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#25445E" BorderThickness="0,0,0,1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanAdd}"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="17" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LocationLabel}" FontSize="11" Foreground="#97B2C5" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Store}" Foreground="#8EDBF7" FontSize="13" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding StateLabel}" Foreground="#A8C4D1" FontSize="11" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="3" Text="Steam ve Epic oyunları mağaza uygulaması üzerinden başlatılır. GOG oyunları yerel EXE ile açılır. Oyun bilgilerinin tamamlanması internet bağlantısına bağlıdır."
                   Foreground="#89AABE" FontSize="12" TextWrapping="Wrap" Margin="0,13,0,10"/>
        <DockPanel Grid.Row="4" LastChildFill="False" Margin="0,8,0,0">
            <Button Content="VAZGEÇ" Click="Cancel_Click" DockPanel.Dock="Right" Margin="12,0,0,0" MinWidth="108"/>
            <Button x:Name="ImportButton" Content="SEÇİLENLERİ EKLE" Click="Import_Click" DockPanel.Dock="Right" MinWidth="175" Background="#4D3681A4"/>
        </DockPanel>
    </Grid>
</Window>
